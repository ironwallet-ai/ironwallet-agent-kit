{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.ironwallet/mcp-server",
  "title": "IronWallet",
  "description": "Non-custodial crypto wallet MCP: check balances, sign and send transfers, and swap tokens locally.",
  "version": "1.2.1",
  "websiteUrl": "https://ironwallet.io/ai",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/ironwallet/ironwallet-agent-kit/main/.github/assets/logo.svg",
      "mimeType": "image/svg+xml",
      "sizes": ["any"]
    }
  ],
  "repository": {
    "url": "https://github.com/ironwallet/ironwallet-agent-kit",
    "source": "github",
    "subfolder": "packages/mcp-server"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@ironwallet/mcp-server",
      "version": "1.2.1",
      "runtimeHint": "npx",
      "environmentVariables": [
        {
          "name": "IW_READ_ONLY",
          "description": "Set to true to disable send_transfer and execute_swap for the whole server. Balances, estimates, and lists still work.",
          "format": "boolean",
          "isRequired": false
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
